{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pts_bomber",
  "version": "2.0.0-2",
  "identifier": "ru.pts-team.pts-bomber",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:3229",
    "beforeBuildCommand": "trunk build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "pts_bomber",
        "decorations": false,
        "transparent": true,
        "center": true,
        "resizable": false,
        "width": 475,
        "height": 225
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
